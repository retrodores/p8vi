# cpmtools disk formats for p8vi's CP/M tests (run cpmtools from this
# directory, or copy the file next to the image: cpmtools reads ./diskdefs
# first).  Homebrew's diskdefs has the same format as trsg, but its comment
# on the diskdef line keeps cpmtools from finding it.

# TRS-80 Model 4, Montezuma Micro CP/M 2.2 system disk: SSDD 40 tracks,
# 18 x 256-byte sectors, 2 boot tracks (170K)
diskdef mm4ss
  seclen 256
  tracks 40
  sectrk 18
  blocksize 2048
  maxdir 128
  skew 2
  boottrk 2
  os 2.2
end
